{
    "name": "wyrd",
    "private": true,
    "version": "0.0.1",
    "description": "Wyrd — mobile-first magical language, puzzle, and duel game prototype.",
    "type": "module",
    "scripts": {
        "prepare": "git config core.hooksPath .githooks || true",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
        "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.json && node --test test/*.test.mjs",
        "version:test": "python3 -m unittest discover -s scripts -v"
    },
    "devDependencies": { "typescript": "^5.9.3" },
    "packageManager": "pnpm@9.12.0",
    "engines": { "node": ">=20" }
}
