{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "rootDir": ".",
        "outDir": "dist",
        "declaration": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["packages/**/src/**/*.ts", "apps/**/src/**/*.ts"],
    // The worker has its own tsconfig (workers-types, Bundler resolution,
    // vitest pool types) and is typechecked by `pnpm typecheck:api`.
    "exclude": ["apps/api/**", "node_modules", "dist"]
}
